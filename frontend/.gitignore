# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committed so a clean clone knows what to set.
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent instruction files regenerated by `next dev` — this project uses the
# root CLAUDE.md instead, so keep them out of the tree
CLAUDE.md
AGENTS.md
