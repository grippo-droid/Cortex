# Copy to .env and fill in real values. Never commit .env.

# --- Auth ---
# MUST be changed: the API refuses to start with this placeholder. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AI provider (OpenAI) ---
# Not required until Phase 2 (ingestion / embeddings).
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Which backend produces embeddings.
#   openai - text-embedding-3-small, 1536 dimensions, needs OPENAI_API_KEY
#   local  - all-MiniLM-L6-v2 via chromadb's bundled ONNX runtime, 384
#            dimensions, no key and no cost (about 80MB downloaded on first use)
# Switching between them requires re-uploading every document: the vectors have
# different dimensions and cannot be mixed in one collection.
EMBEDDING_PROVIDER=openai

# --- Chat provider ---
# Which backend generates answers: openai or groq. Groq's API is
# OpenAI-compatible and has a free tier, which is why development used it.
# Unlike embeddings, switching this is free: nothing generated is stored, so no
# documents need re-uploading.
CHAT_PROVIDER=openai
GROQ_API_KEY=gsk_...
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --- Reliability bounds (optional; these are the defaults) ---
# Every provider call is bounded and retried with exponential backoff and
# jitter. Without an explicit timeout the OpenAI SDK waits 600 seconds and
# retries twice on its own, which can hold an upload open for many minutes.
# Raise the timeouts on a slow connection; lower them to fail faster.
# LLM_TIMEOUT_SECONDS=60
# LLM_STREAM_TIMEOUT_SECONDS=120
# LLM_MAX_ATTEMPTS=3
# EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_MAX_ATTEMPTS=3

# --- Retrieval relevance (optional; this is the default) ---
# Cosine distance beyond which a retrieved chunk counts as unrelated to the
# question and is dropped. When everything is dropped the question is refused
# without calling the model. Measured on all-MiniLM-L6-v2; the scale is
# model-specific, so re-measure after switching embedding provider with
#   cd backend && EMBEDDING_PROVIDER=... PYTHONPATH=. \
#       python ../docs/measurements/measure_distances.py
# Set to 0 to disable filtering entirely.
# RETRIEVAL_MAX_DISTANCE=0.75

# --- Storage ---
DATABASE_URL=sqlite:///./cortex.db
CHROMA_PERSIST_DIR=./chroma_data

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000
